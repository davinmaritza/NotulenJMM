PROJECT_NAME="NotulenJMM Backend API"
VERSION="0.3.0"
API_V1_STR="/api/v1"

# 9Router AI Gateway Configuration
LLM_BASE_URL="https://routernines.bytenodes.icu/v1"
LLM_API_KEY="your-9router-api-key"
LLM_MODEL="ag/gemini-3.8-flash"

# Microsoft VibeVoice Service Configuration
VIBEVOICE_ENDPOINT="http://localhost:8001/asr"
VIBEVOICE_FRAME_RATE_HZ=7.5
UPLOAD_DIR="/tmp/notulenjmm_audio"
