# Backend API Configuration
PROJECT_NAME="NotulenJMM Backend API"
VERSION="0.2.0"
API_V1_STR="/api/v1"
PORT=8000

# 9Router AI Gateway (https://9router.com/)
LLM_BASE_URL="http://localhost:20128/v1"
LLM_API_KEY="9router-default-key"
LLM_MODEL="router-default"

# Microsoft VibeVoice Service (https://github.com/microsoft/VibeVoice)
VIBEVOICE_ENDPOINT="http://localhost:8001/asr"
VIBEVOICE_FRAME_RATE_HZ=7.5

# Audio Temporary Storage
UPLOAD_DIR="/tmp/notulenjmm_audio"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
