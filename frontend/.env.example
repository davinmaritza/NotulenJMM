# ==============================================================================
# NotulenJMM Frontend Environment Variables
# ==============================================================================

# 1. Backend API Endpoint
# Lokal: "http://localhost:8000"
# Produksi (misal backend di subpath/domain lain): "https://jmm.davinn.net/api" atau "https://api-jmm.davinn.net"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# 2. Google OAuth 2.0 Web Client ID
# Daftarkan di Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript origins:
#   - http://localhost:3000
#   - https://jmm.davinn.net
# Authorized redirect URIs:
#   - http://localhost:3000
#   - https://jmm.davinn.net
#
# Catatan: Jika dikosongkan (""), NotulenJMM otomatis menggunakan sistem sesi instan 1-klik lokal & cadangan berkas mandiri.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
